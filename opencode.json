{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "dart": {
      "command": [
        "dart",
        "language-server",
        "--protocol=lsp"
      ],
      "extensions": [
        ".dart"
      ]
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp"
        ]
      },
      "dart-mcp-server": {
        "type": "local",
        "command": [
          "dart",
          "mcp-server"
        ],
        "environment": {}
      },
      "supabase": {
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp"
      }
    }
  },
}