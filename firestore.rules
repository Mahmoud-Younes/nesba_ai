rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validGoalSource() {
      return !('goalSource' in request.resource.data)
        || request.resource.data.goalSource == null
        || request.resource.data.goalSource in ['calculated', 'manual'];
    }

    function validContains() {
      return !('contains' in request.resource.data)
        || request.resource.data.contains is list;
    }

    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && validGoalSource()
        && validContains();
      allow delete: if false;

      match /meals/{mealId} {
        allow read: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && validContains();
        allow delete: if signedInAs(uid);
      }
    }
  }
}
